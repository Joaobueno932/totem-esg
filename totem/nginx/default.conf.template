# Servidor do totem (PWA). O entrypoint da imagem nginx gera /etc/nginx/conf.d/default.conf
# a partir deste template na inicialização, substituindo ${BACKEND_URL} pelo valor do
# ambiente (validado em /docker-entrypoint.d/05-validar-ambiente.envsh).

# Arquivos com hash no nome podem ficar em cache para sempre; o resto revalida sempre
# (index.html, sw.js e manifest precisam disso para o PWA receber atualizações).
map $uri $totem_cache_control {
    ~^/assets/  "public, max-age=31536000, immutable";
    default     "no-cache";
}

# Preserva o protocolo original quando há TLS terminado antes (ingress/gateway).
map $http_x_forwarded_proto $totem_forwarded_proto {
    default $http_x_forwarded_proto;
    ""      $scheme;
}

server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    server_tokens off;

    add_header Cache-Control $totem_cache_control;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    gzip on;
    gzip_min_length 1024;
    gzip_types text/css application/javascript application/json application/manifest+json image/svg+xml;

    # Sonda do contêiner (liveness/readiness): não depende do backend.
    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # Proxy reverso para a API: o navegador fala só com este host (mesma origem, sem CORS)
    # e o backend pode ficar interno ao cluster (ClusterIP). O totem é público, então só
    # passam as rotas que ele usa; as administrativas não são expostas por aqui.
    location ~ ^/api/(public/|sync/|health$) {
        proxy_pass ${BACKEND_URL};
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $totem_forwarded_proto;
        proxy_connect_timeout 5s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
        client_max_body_size 2m;
    }

    location /api/ {
        default_type "application/json; charset=utf-8";
        return 404 '{"error":"Não encontrado"}';
    }

    # SPA: /<slug-do-evento> cai no index.html.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
