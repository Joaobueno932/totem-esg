# Modelo de configuração. Copie para .env (desenvolvimento) — o .env nunca vai para o Git.
# Em contêiner/Kubernetes, as mesmas variáveis vêm do ambiente (ConfigMap + Secret).

# Porta da API
PORT=3001

# Conexão PostgreSQL (SEGREDO). Local: docker compose up -d postgres
# Banco gerenciado: inclua sslmode=require (o certificado do servidor é validado).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/carbono_zero

# Segredo do JWT (SEGREDO). Em produção use um valor longo e aleatório:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=troque-este-segredo-em-producao

# Expiração do token de admin
JWT_EXPIRES_IN=8h

# Origens permitidas no CORS das rotas /api/admin (separadas por vírgula).
# Sem a variável, vale *. Com o dashboard servindo a API na mesma origem (proxy do
# nginx da imagem), o CORS não entra em jogo; informe mesmo assim a URL do dashboard.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Rate limit da rota pública de sincronização (requisições por janela de 15 min, por IP)
SYNC_RATE_LIMIT=300

# Proxies confiáveis para descobrir o IP do cliente (rate limit): true | false | nº de
# saltos | lista de IPs/sub-redes. Atrás de ingress + nginx do frontend, use o nº de
# saltos (ex.: 2); com true o IP vem do primeiro X-Forwarded-For, que o cliente forja.
TRUST_PROXY=true

# Em produção defina NODE_ENV=production (a imagem Docker já define).
# NODE_ENV=production

# Admin criado/atualizado na inicialização (imagem Docker) ou no build do Netlify
# (npm run create-admin:env). Sem ADMIN_EMAIL/ADMIN_PASSWORD o passo é ignorado.
# A senha (SEGREDO) é regravada a cada inicialização enquanto a variável existir:
# remova-a depois de criar o primeiro acesso.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administrador
