# Normaliza fins de linha no repositório (LF) e mantém LF no checkout dos arquivos
# executados dentro dos contêineres, mesmo em máquinas Windows com core.autocrlf=true.
* text=auto
*.sh text eol=lf
*.envsh text eol=lf
*.template text eol=lf
Dockerfile text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.png binary
*.webp binary
*.jpg binary
*.pdf binary
*.woff2 binary
