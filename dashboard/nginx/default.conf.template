# Servidor do dashboard (SPA). O entrypoint da imagem nginx gera /etc/nginx/conf.d/default.conf
# a partir deste template na inicialização, substituindo ${BACKEND_URL} e ${TOTEM_PUBLIC_URL}
# pelos valores do ambiente (validados em /docker-entrypoint.d/05-validar-ambiente.envsh).

# Arquivos com hash no nome podem ficar em cache para sempre; o resto revalida sempre.
map $uri $dashboard_cache_control {
    ~^/assets/  "public, max-age=31536000, immutable";
    default     "no-cache";
}

# Preserva o protocolo original quando há TLS terminado antes (ingress/gateway).
map $http_x_forwarded_proto $dashboard_forwarded_proto {
    default $http_x_forwarded_proto;
    ""      $scheme;
}

server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    server_tokens off;

    add_header Cache-Control $dashboard_cache_control;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header X-Frame-Options "DENY" always;

    gzip on;
    gzip_min_length 1024;
    gzip_types text/css application/javascript application/json image/svg+xml text/csv;

    # Sonda do contêiner (liveness/readiness): não depende do backend.
    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # Configuração de execução lida pelo app antes de iniciar (ver src/api.js).
    location = /config.js {
        default_type application/javascript;
        return 200 'window.__APP_CONFIG__ = {"totemUrl": "${TOTEM_PUBLIC_URL}"};';
    }

    # Proxy reverso para a API: o navegador fala só com este host (mesma origem, sem CORS)
    # e o backend pode ficar interno ao cluster (ClusterIP). O token JWT segue no
    # cabeçalho Authorization, sem cookies.
    location /api/ {
        proxy_pass ${BACKEND_URL};
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $dashboard_forwarded_proto;
        proxy_connect_timeout 5s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
        # a API aceita até 3 MB (imagem do evento em base64)
        client_max_body_size 4m;
    }

    # SPA: rotas do react-router caem no index.html.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
