# Variáveis de BUILD do dashboard (lidas pelo Vite no `npm run build`/`npm run dev`).
# Nada aqui é segredo: tudo vai para o JavaScript entregue ao navegador.

# URL da API. Vazio (padrão) = mesma origem: o navegador chama /api/... no próprio host
# e quem encaminha ao backend é o proxy (nginx da imagem Docker; em dev, o Vite).
# Preencha só se a API estiver em outro domínio (ex.: https://api.exemplo.com.br).
VITE_API_URL=

# URL pública do totem, usada para montar o link/QR de cada evento.
# Na imagem Docker vale a variável de execução TOTEM_PUBLIC_URL (sem rebuild).
VITE_TOTEM_URL=http://localhost:5173

# Só desenvolvimento: para onde o Vite encaminha /api (padrão http://localhost:3001).
# API_PROXY_TARGET=http://localhost:3001
